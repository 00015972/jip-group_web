# Shared by every dukonline storefront. The store is selected by the key, not
# by this URL, so it only changes for a local backend.
DUKONLINE_API_URL=https://api.dukonline.uz/api

# ERP SuperAdmin panel -> organization -> Online Store.
# Server-side only: it never reaches the browser bundle.
DUKONLINE_STOREFRONT_KEY=

# Optional. The public address (https://...), used for link previews.
# SITE_URL=
